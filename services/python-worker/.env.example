APP_ENV=local
LOG_LEVEL=INFO
WORKER_ID=script-worker-local

# RabbitMQ：与 packages/contracts/asyncapi/asyncapi.yaml 对齐
RABBITMQ_URL=amqp://auto_drama:auto_drama_dev@localhost:5672/
RABBITMQ_EXCHANGE=drama.tasks
RABBITMQ_QUEUE=drama.task.execute
RABBITMQ_ROUTING_KEY=task.execute
RABBITMQ_PREFETCH_COUNT=1
MAX_RETRIES=3

# Java Internal Callback
JAVA_CALLBACK_BASE_URL=http://localhost:8080
JAVA_INTERNAL_TOKEN=local-dev-token
CALLBACK_TIMEOUT_SECONDS=10

# 文本模型：默认 Mock，联调真实模型时再切换
TEXT_MODEL_PROVIDER=mock
TEXT_MODEL_NAME=mock-text-v1
TEXT_MODEL_BASE_URL=
TEXT_MODEL_API_KEY=
TEXT_MODEL_TIMEOUT_SECONDS=60
MOCK_SCENARIO=happy_path

# Prompt 版本
PROMPT_VERSION_EXPANDER=v1
PROMPT_VERSION_GENERATOR=v1
PROMPT_VERSION_QUALITY_CHECKER=v1
PROMPT_VERSION_REWRITER=v1
PROMPT_VERSION_BIBLE_EXTRACTOR=v1
