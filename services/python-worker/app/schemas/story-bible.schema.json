{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.auto-drama-studio.local/generation-spec/v1/story-bible.schema.json",
  "title": "StoryBible",
  "description": "最终 Script 通过质量检查后提取的静态故事圣经。只保存 metadata 与 worldSettings。",
  "$comment": "StoryBible 只保存跨场景稳定事实；人物当前状态、道具位置、天气变化、Scene 与 Shot 均属于动态实例，不得写入本对象。",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "worldSettings"],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "worldSettings": {
      "$ref": "#/$defs/worldSettings"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "logline",
        "genre",
        "language",
        "targetDurationSeconds",
        "aspectRatio",
        "tone",
        "visualStyle",
        "directorialVoice"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "logline": {"type": "string", "minLength": 1, "maxLength": 1000},
        "genre": {"type": "string", "minLength": 1, "maxLength": 100},
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "description": "BCP 47 风格语言标签，例如 zh-CN。"
        },
        "targetDurationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "tone": {"type": "string", "minLength": 1, "maxLength": 500},
        "visualStyle": {"type": "string", "minLength": 1, "maxLength": 1000},
        "directorialVoice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "功能性导演声音，不使用具名在世导演或工作室作为风格捷径。"
        }
      }
    },
    "worldSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timePeriod",
        "geography",
        "socialContext",
        "worldRules",
        "environmentBaseline",
        "colorAndLightBaseline",
        "coreThemes",
        "forbiddenContradictions"
      ],
      "properties": {
        "timePeriod": {"type": "string", "minLength": 1, "maxLength": 500},
        "geography": {"type": "string", "minLength": 1, "maxLength": 1000},
        "socialContext": {"type": "string", "minLength": 1, "maxLength": 2000},
        "worldRules": {
          "$ref": "#/$defs/uniqueStringList"
        },
        "environmentBaseline": {"type": "string", "minLength": 1, "maxLength": 2000},
        "colorAndLightBaseline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "跨场景稳定的色彩与有物理来源的光线基线。"
        },
        "coreThemes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "forbiddenContradictions": {
          "$ref": "#/$defs/uniqueStringList"
        }
      }
    },
    "uniqueStringList": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    }
  }
}
