{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.auto-drama-studio.local/generation-spec/task-execution.schema.json",
  "title": "GenerationTask execution message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "taskId",
    "taskType",
    "projectId",
    "episodeId",
    "attempt",
    "traceId",
    "createdAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "taskType": {
      "type": "string",
      "enum": [
        "script.generate",
        "shot.generate",
        "asset.extract",
        "keyframe.generate",
        "video.generate",
        "audio.subtitle",
        "export.compose"
      ]
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "episodeId": {
      "type": "string",
      "format": "uuid"
    },
    "shotId": {
      "type": "string",
      "format": "uuid"
    },
    "panelId": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "description": "Immutable input snapshot consumed by the worker. sourceText and projectConfig are supplied for every MS1 task; task-specific inputs may add fields.",
      "additionalProperties": true,
      "required": [
        "sourceText",
        "projectConfig"
      ],
      "properties": {
        "sourceText": {
          "type": "string",
          "minLength": 1,
          "description": "Source text snapshot selected by Java when the task is created."
        },
        "projectConfig": {
          "type": "object",
          "additionalProperties": true,
          "description": "Project configuration snapshot, for example projectType, targetDurationSeconds, aspectRatio and style."
        }
      }
    }
  }
}
