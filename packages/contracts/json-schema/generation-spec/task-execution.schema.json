{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.auto-drama-studio.local/generation-spec/task-execution.schema.json",
  "title": "GenerationTask execution message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "taskId",
    "taskType",
    "projectId",
    "episodeId",
    "attempt",
    "traceId",
    "createdAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "taskType": {
      "type": "string",
      "enum": [
        "script.generate",
        "shot.generate",
        "asset.extract",
        "asset.image.generate",
        "keyframe.generate",
        "video.generate",
        "audio.subtitle",
        "export.compose"
      ]
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "episodeId": {
      "type": "string",
      "format": "uuid"
    },
    "shotId": {
      "type": "string",
      "format": "uuid"
    },
    "panelId": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "description": "不可变输入快照；字段按 taskType 而定：script/shot 用 sourceText+projectConfig；媒体任务（keyframe/video/audio/export/asset.image）用对应 Revision 快照 id，而非文本。",
      "$comment": "keyframe.generate 示例 payload：{ shotIds, assetIds, keyframeIds }。video/audio/export/asset.image.generate 的 payload 字段待罗诗辉最终定义后补入。",
      "additionalProperties": true,
      "properties": {
        "sourceText": {
          "type": "string",
          "minLength": 1,
          "description": "文本任务（script/shot）的源文本快照。"
        },
        "projectConfig": {
          "type": "object",
          "additionalProperties": true,
          "description": "项目配置快照：projectType、targetDurationSeconds、aspectRatio、style 等。"
        },
        "shotIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "媒体任务涉及的镜头 id（如 keyframe.generate）。"
        },
        "assetIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "解析后的资产 / 资产版本 id。"
        },
        "keyframeIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "选定的关键帧 id。"
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "文本任务：payload 必须携带 sourceText 与 projectConfig。",
      "if": { "required": ["taskType"], "properties": { "taskType": { "enum": ["script.generate", "shot.generate"] } } },
      "then": { "properties": { "payload": { "required": ["sourceText", "projectConfig"] } } }
    },
    {
      "$comment": "关键帧任务：payload 必须携带 shotIds（不再强制 sourceText）。",
      "if": { "required": ["taskType"], "properties": { "taskType": { "const": "keyframe.generate" } } },
      "then": { "properties": { "payload": { "required": ["shotIds"] } } }
    }
  ]
}
