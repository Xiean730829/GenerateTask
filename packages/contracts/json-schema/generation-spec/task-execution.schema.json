{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.auto-drama-studio.local/generation-spec/task-execution.schema.json",
  "title": "GenerationTask execution message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "taskId",
    "taskType",
    "projectId",
    "episodeId",
    "attempt",
    "traceId",
    "createdAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "taskType": {
      "type": "string",
      "enum": [
        "script.generate",
        "shot.generate",
        "asset.extract",
        "asset.image.generate",
        "keyframe.generate",
        "video.generate",
        "audio.subtitle",
        "export.compose"
      ]
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "episodeId": {
      "type": "string",
      "format": "uuid"
    },
    "shotId": {
      "type": "string",
      "format": "uuid"
    },
    "panelId": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "description": "不可变输入快照。Python Worker 不读数据库，故 payload 必须自包含：文本任务携带文本，媒体任务携带不可变 Revision id + 生成所需的已解析内容（媒体统一走 OSS 签名 URL）。各 taskType 的必需字段由下方 allOf 按类型强制。",
      "$comment": "字段依不可变 Revision 架构（Issue #12）初定，具体以 worker 实现对齐；additionalProperties:true 允许 worker 扩展。",
      "additionalProperties": true,
      "properties": {
        "projectConfig": {
          "type": "object",
          "additionalProperties": true,
          "description": "项目配置快照：projectType、targetDurationSeconds、aspectRatio、style。用于保持全链路风格一致。"
        },
        "sourceText": {
          "type": "string",
          "minLength": 1,
          "description": "[script.generate] 一句话/材料源文本快照。"
        },
        "scriptText": {
          "type": "string",
          "minLength": 1,
          "description": "[shot.generate] 待拆分的剧本全文（来自 GeneratedScript.scriptText）。"
        },
        "assetId": {
          "type": "string",
          "format": "uuid",
          "description": "[asset.image.generate] 目标资产 id。"
        },
        "assetRevisionId": {
          "type": "string",
          "format": "uuid",
          "description": "[asset.image.generate] 渲染所依据的不可变 AssetRevision。"
        },
        "prompt": {
          "type": "string",
          "description": "[asset.image.generate] 由 Revision 属性推导出的渲染提示词。"
        },
        "shotIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "[keyframe.generate] 本批目标镜头 id。"
        },
        "renderItems": {
          "type": "array",
          "description": "[keyframe.generate] 每个镜头的已解析渲染快照：镜头 id、ShotPromptRevision、提示词、景别、参考图 OSS URL 等。",
          "items": { "type": "object", "additionalProperties": true }
        },
        "panelId": {
          "type": "string",
          "format": "uuid",
          "description": "[video.generate] 目标片段 id。"
        },
        "panelRevisionId": {
          "type": "string",
          "format": "uuid",
          "description": "[video.generate] 生成所依据的唯一不可变 PanelRevision。"
        },
        "keyframeImageUrls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "description": "[video.generate] 该 PanelRevision 选定关键帧的 OSS 签名 URL（作为首/尾帧或条件帧）。"
        },
        "dialogueLines": {
          "type": "array",
          "description": "[audio.subtitle] 已解析台词序列：镜头、说话人、台词、起止时间，用于配音与字幕对齐。",
          "items": { "type": "object", "additionalProperties": true }
        },
        "voice": {
          "type": "object",
          "additionalProperties": true,
          "description": "[audio.subtitle] 音色配置：角色→音色映射或 MS1 固定音色。"
        },
        "timelineId": {
          "type": "string",
          "format": "uuid",
          "description": "[export.compose] 待导出的时间线 id。"
        },
        "segments": {
          "type": "array",
          "description": "[export.compose] 按顺序排列的合成片段：片段视频 URL、音频 URL、字幕 URL、时长，供 ffmpeg 拼接。",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "script.generate：源文本 + 项目配置。",
      "if": { "required": ["taskType"], "properties": { "taskType": { "const": "script.generate" } } },
      "then": { "properties": { "payload": { "required": ["sourceText", "projectConfig"] } } }
    },
    {
      "$comment": "shot.generate：剧本全文 + 项目配置。",
      "if": { "required": ["taskType"], "properties": { "taskType": { "const": "shot.generate" } } },
      "then": { "properties": { "payload": { "required": ["scriptText", "projectConfig"] } } }
    },
    {
      "$comment": "asset.image.generate：资产 + 其不可变 Revision。",
      "if": { "required": ["taskType"], "properties": { "taskType": { "const": "asset.image.generate" } } },
      "then": { "properties": { "payload": { "required": ["assetId", "assetRevisionId"] } } }
    },
    {
      "$comment": "keyframe.generate：目标镜头 + 已解析渲染快照。",
      "if": { "required": ["taskType"], "properties": { "taskType": { "const": "keyframe.generate" } } },
      "then": { "properties": { "payload": { "required": ["shotIds", "renderItems"] } } }
    },
    {
      "$comment": "video.generate：片段 + 其唯一 PanelRevision。",
      "if": { "required": ["taskType"], "properties": { "taskType": { "const": "video.generate" } } },
      "then": { "properties": { "payload": { "required": ["panelId", "panelRevisionId"] } } }
    },
    {
      "$comment": "audio.subtitle：已解析台词序列。",
      "if": { "required": ["taskType"], "properties": { "taskType": { "const": "audio.subtitle" } } },
      "then": { "properties": { "payload": { "required": ["dialogueLines"] } } }
    },
    {
      "$comment": "export.compose：时间线 + 有序合成片段。",
      "if": { "required": ["taskType"], "properties": { "taskType": { "const": "export.compose" } } },
      "then": { "properties": { "payload": { "required": ["timelineId", "segments"] } } }
    }
  ]
}
