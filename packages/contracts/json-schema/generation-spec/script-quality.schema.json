{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.auto-drama-studio.local/generation-spec/script-quality.schema.json",
  "title": "ScriptQuality 剧本质检结果",
  "description": "script.generate 产物的一部分：剧本质检结论。passed=false 时 problems 应列出问题；二次质检仍失败则任务以 SCRIPT_QUALITY_CHECK_FAILED 回写失败。",
  "$comment": "problems 单项结构（如 code/message/severity）待罗诗辉定稿；当前放宽为任意对象。",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "problems", "summary"],
  "properties": {
    "passed": {
      "description": "是否通过质检",
      "type": "boolean"
    },
    "score": {
      "description": "质检评分（0-100）。可空。",
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "problems": {
      "description": "问题列表；通过时为空数组",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "summary": {
      "description": "质检结论摘要",
      "type": "string"
    }
  }
}
